/*
===============================================================================
Create Database and Schemas
===============================================================================
Script Purpose:
This script creates a database named 'DataWarehouse'. If the database already
exists, it is dropped and recreated. The script then creates the bronze,
silver, and gold schemas.
===============================================================================
WARNING:
Running this script will delete the entire 'DataWarehouse' database if it exists.
Ensure you have a backup before running it.
*/
===============================================================================

USE master;
GO

-- Drop and recreate the DataWarehouse database.
IF EXISTS (SELECT * FROM sys.databases WHERE name = 'DataWarehouse')
BEGIN
    ALTER DATABASE DataWarehouse SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE DataWarehouse;
END;
GO

CREATE DATABASE DataWarehouse;
GO

USE DataWarehouse;
GO

-- Create the schemas.
CREATE SCHEMA bronze;
GO
CREATE SCHEMA silver;
GO
CREATE SCHEMA gold;
GO
